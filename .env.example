# Kopiér denne fil til .env og udfyld dine nøgler.
# Brug ALDRIG rigtige secrets i git eller delte filer.
# Indlæses automatisk af python-dotenv i app.py.

# Customer.io App API key (Bearer).
# Opret under Settings → API Credentials → App API Key.
# Bruges til GET https://api.customer.io/v1/campaigns
CUSTOMERIO_APP_API_KEY=your_customerio_app_api_key_here

# Valgfri: brug "eu" hvis din Customer.io workspace er i EU-regionen.
# Tom eller "us" → https://api.customer.io
# "eu" → https://api-eu.customer.io
CUSTOMERIO_REGION=us

# Lemlist API key (HTTP Basic: tomt brugernavn + key som password).
# Opret under Settings → Integrations → Generate API key.
# Bruges til GET https://api.lemlist.com/api/campaigns
LEMLIST_API_KEY=your_lemlist_api_key_here

# Instantly / Smartlead / Apollo / Clay / HubSpot / PostHog:
# Endnu ingen Live API-klienter i appen — kun Dummy-data.
# Nøgler kan tilføjes her senere, når Live-stubs udvides.
